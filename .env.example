# ---------------------------------------------------------------------------
# SubTranslate - environment variables
# Copy this file to `.env.local` (never commit `.env.local`).
#
# The app is designed to boot WITHOUT any keys: it falls back to local-only
# mode (on-device speech + MyMemory translation + guest profile).
# ---------------------------------------------------------------------------

# Supabase (Free Tier) ------------------------------------------------------
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=your_free_supabase_url
VITE_SUPABASE_ANON_KEY=your_free_supabase_anon_key

# Optional: Supabase Edge Function that proxies Deepgram (recommended for prod)
# VITE_DEEPGRAM_PROXY_URL=https://your-project.supabase.co/functions/v1/deepgram-token

# Deepgram free credit ($200 sign-up credit) --------------------------------
# WARNING: a browser WebSocket cannot send Authorization headers, so this key
# is exposed to the client. Keep it in a throwaway project for testing only.
# For production use VITE_DEEPGRAM_PROXY_URL so the key stays server-side.
VITE_DEEPGRAM_API_KEY=

# Free translation ----------------------------------------------------------
# Provider: "mymemory" (no key, ~1k words/day) or "libretranslate"
VITE_TRANSLATION_PROVIDER=mymemory
# Self-hosted / public LibreTranslate endpoint (optional)
# VITE_LIBRETRANSLATE_URL=https://libretranslate.com
# Optional contact email for the free MyMemory quota
# VITE_MYMEMORY_EMAIL=you@example.com

# On-device Whisper (transformers.js WASM) ----------------------------------
# Tiny is ~40MB quantized; base is ~80MB. Model weights are cached by the SW.
VITE_WHISPER_MODEL=Xenova/whisper-tiny
VITE_WHISPER_CHUNK_SECONDS=5
