{
  "appId": "com.subtranslate.app",
  "appName": "SubTranslate",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "app.subtranslate.local",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0F172A"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    },
    "App": {
      "webContentsDebuggingEnabled": false
    }
  }
}
